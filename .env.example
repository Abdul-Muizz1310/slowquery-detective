# ---------------------------------------------------------------------------
# slowquery-detective — environment variables
# ---------------------------------------------------------------------------
# This package is a library: install() takes its configuration as arguments.
# The variables below are the ones a host application typically reads from
# its own settings and passes to
#   slowquery_detective.install(app, engine, service=..., ...)
#
# Copy to `.env` for local development; never commit `.env`.
# ---------------------------------------------------------------------------

# --- Slow-query detection -------------------------------------------------
# Statements at or above this (in ms) are sampled and sent to EXPLAIN.
# 100ms is a reasonable starting point for web workloads.
SLOWQUERY_THRESHOLD_MS=100

# Fraction of untagged statements to record (0.0–1.0). Statements run under
# an X-Request-Id are always recorded.
SLOWQUERY_SAMPLE_RATE=1.0

# The Postgres the store writes to (schema `slowquery`, created at startup).
# Usually the service's own DATABASE_URL. Neon's ?sslmode=require&
# channel_binding=require form is accepted and normalised for asyncpg.
# Leave unset to use the in-memory store (tests, SQLite).
SLOWQUERY_STORE_URL=postgresql+asyncpg://user:password@host/db

# Seconds to keep samples and per-request aggregates (default 7 days).
SLOWQUERY_RETENTION_S=604800

# There is no shared-secret setting any more: access to /_slowquery is
# decided by the `authorize` hook the host passes to install(). The 0.1
# variables SLOWQUERY_PLATFORM_TOKEN and DEMO_MODE are not read.

# --- LLM fallback (optional) ----------------------------------------------
# When the rules engine returns no suggestion, fall back to an LLM. Disabled
# by default. Set to `true` to enable (and pass an LlmConfig).
LLM_FALLBACK_ENABLED=false

# OpenRouter credentials. The cascade talks to the OpenRouter REST API
# directly over httpx. The model slots default to these free models.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_PRIMARY=google/gemma-4-26b-a4b-it:free
OPENROUTER_MODEL_FAST=xingchen-agi/xing4.0-29b-a4b:free
OPENROUTER_MODEL_FALLBACK=google/gemma-4-31b-it:free
